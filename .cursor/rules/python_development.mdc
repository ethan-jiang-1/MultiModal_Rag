## 核心原则
> required: true

### KISS原则
```python
# ✅ 推荐：简单直接的实现
class UserService:
    """用户服务，保持简单"""
    def get_user(self, user_id: int) -> Dict:
        return self.db.query(f"SELECT * FROM users WHERE id = {user_id}")
    
    def validate_user(self, user: Dict) -> bool:
        return bool(user and user.get('id') and user.get('name'))

# ❌ 避免：过度设计
class UserServiceFactory:
    @staticmethod
    def create_service(type: str) -> UserServiceBase:
        if type == "admin":
            return AdminUserService(UserValidator(), UserRepository())
        elif type == "guest":
            return GuestUserService(GuestValidator(), GuestRepository())
        # 过度的抽象和工厂模式
```

### 显式优于隐式
```python
# ✅ 推荐：明确的参数验证和返回值
def get_user_by_id(user_id: int) -> Optional[Dict]:
    """根据ID获取用户信息，不存在返回None"""
    if not isinstance(user_id, int):
        raise ValueError("用户ID必须是整数")
    return db.query(User).filter_by(id=user_id).first()

# ❌ 避免：隐含的类型转换和返回值
def get_user(id):
    # 可能隐式转换id类型，可能返回None或抛出异常
    return db.query(User).filter_by(id=id).first()
```

### 组合优于继承
```python
# ✅ 推荐：使用组合实现功能
class DataProcessor:
    """通过组合方式处理数据"""
    def __init__(self, reader: DataReader, validator: DataValidator):
        self.reader = reader
        self.validator = validator
    
    def process(self, data_path: str) -> Dict:
        data = self.reader.read(data_path)
        return self.validator.validate(data)

# ❌ 避免：过度继承
class BaseProcessor:
    def read(self): pass
    def validate(self): pass
    def process(self): pass

class JsonProcessor(BaseProcessor):  # 继承导致强耦合
    def read(self): pass
    def validate(self): pass
```

### 局部优于全局
```python
# ✅ 推荐：依赖注入
class ImageProcessor:
    def __init__(self, config: Config):
        self.config = config
    
    def process_image(self, image: np.ndarray) -> np.ndarray:
        return cv2.resize(image, self.config.target_size)

# ❌ 避免：全局状态
CONFIG = {"target_size": (224, 224)}  # 全局配置
def process_image(image):
    return cv2.resize(image, CONFIG["target_size"])
```

### 代码质量
```python
# ✅ 推荐：清晰的类型注解和文档
def calculate_average(scores: List[float]) -> float:
    """计算平均分数，无数据时返回0"""
    return sum(scores) / len(scores) if scores else 0.0

# ❌ 避免：含糊不清的实现
def calc(s):
    return s and sum(s)/len(s) or 0
```

### 错误处理
```python
# ✅ 推荐：明确的错误处理
def process_data(data: Dict) -> Dict:
    """处理数据，包含错误处理"""
    if not isinstance(data, dict):
        raise ValueError("输入必须是字典类型")
    if not data:
        raise ValueError("数据不能为空")
    return {"result": transform(data)}

# ❌ 避免：隐藏错误
def process(d):
    try:
        return transform(d)
    except:
        return {}
```

## 代码组织
> required: true

### 模块结构
```python
# 标准库导入
from typing import Dict, List
from pathlib import Path

# 第三方库导入
import numpy as np
import pandas as pd

# 本地模块导入
from .core import process_data
from .utils import validate_input

# 模块接口定义
__all__ = ['DataProcessor', 'process_batch']
```

### 类设计
```python
@dataclass
class Config:
    """配置数据类，使用dataclass简化配置管理"""
    model_path: Path
    batch_size: int
    max_retries: int = 3

class DataProcessor:
    """数据处理器，职责单一"""
    def __init__(self, config: Config):
        self.config = config
        self._validate_config()

    def process(self, data: List[Dict]) -> List[Dict]:
        """处理数据批次"""
        return [self._process_item(item) for item in data]
```

